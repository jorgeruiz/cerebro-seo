generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NextAuth models
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  EDITOR
  CLIENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(EDITOR)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Dominio del negocio
// ---------------------------------------------------------------------------

model Client {
  id              String   @id @default(cuid())
  cerebroClientId String?  @unique
  name            String
  domain          String
  plan            SeoPlan
  status          ClientStatus
  services        String[] @default([])  // slugs: "seo", "google_ads", "meta_ads", "contenidos"
  brandColor      String?
  createdAt       DateTime @default(now())

  sites            Site[]
  keywords         Keyword[]
  competitors      Competitor[]
  cycles           MonthlyCycle[]
  hypotheses       Hypothesis[]
  insights         Insight[]
  events           TimelineEvent[]
  clientUsers      ClientUser[]
  aiSearchVisibility AiSearchVisibility[]
  audits           Audit[]
  backlinks        Backlink[]
  backlinkSnapshots BacklinkSnapshot[]
  competitorSnapshots    CompetitorSnapshot[]
  competitorKeywordGaps  CompetitorKeywordGap[]
}

model Site {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  url         String
  gscProperty String?
  ga4Property String?

  audits      Audit[]
  pageMetrics PageMetric[]
  backlinks   Backlink[]
}

model MonthlyCycle {
  id              String      @id @default(cuid())
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  yearMonth       String
  status          CycleStatus
  strategySummary String?     @db.Text
  focus           String?     // Foco del mes (del sync con Cerebro)
  goals           String[]    @default([]) // Objetivos del mes (del sync con Cerebro)
  notionPageId    String?
  reportPdfUrl    String?
  startedAt       DateTime
  closedAt        DateTime?

  tasks      Task[]
  hypotheses Hypothesis[]

  @@unique([clientId, yearMonth])
}

model Task {
  id               String       @id @default(cuid())
  cycleId          String
  cycle            MonthlyCycle @relation(fields: [cycleId], references: [id])
  notionTaskId     String?      @unique
  title            String
  description      String?      @db.Text
  status           TaskStatus
  priority         Int
  assignedTo       String?
  dueDate          DateTime?
  completedAt      DateTime?
  affectedUrls     String[]
  affectedKeywords Keyword[]

  hypothesis Hypothesis?
}

model Hypothesis {
  id              String           @id @default(cuid())
  clientId        String
  client          Client           @relation(fields: [clientId], references: [id])
  cycleId         String
  cycle           MonthlyCycle     @relation(fields: [cycleId], references: [id])
  taskId          String?          @unique
  task            Task?            @relation(fields: [taskId], references: [id])
  statement       String           @db.Text
  expectedMetric  String
  expectedDelta   Float
  timeframeDays   Int
  baseline        Json
  validation      ValidationStatus
  validatedAt     DateTime?
  validationNotes String?          @db.Text
}

model Keyword {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  term       String
  country    String    @default("MX")
  language   String    @default("es")
  targetUrl  String?
  isPriority Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  rankings        KeywordRanking[]
  affectedByTasks Task[]

  @@index([clientId, isPriority])
  @@index([clientId, deletedAt])
}

model KeywordRanking {
  id           String   @id @default(cuid())
  keywordId    String
  keyword      Keyword  @relation(fields: [keywordId], references: [id])
  date         DateTime
  position     Int?
  rankingUrl   String?
  searchEngine String   @default("google")
  delta        Int?

  @@index([keywordId, date])
}

model Competitor {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  domain          String
  domainAuthority Int?
  lastAnalyzed    DateTime?
  snapshotData    Json?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  snapshots   CompetitorSnapshot[]
  keywordGaps CompetitorKeywordGap[]
}

model CompetitorSnapshot {
  id                 String     @id @default(cuid())
  clientId           String
  client             Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competitorId       String
  competitor         Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  domainRank         Int?
  totalBacklinks     Int?
  uniqueDomains      Int?
  rankedKeywords     Int?
  estimatedTraffic   Int?

  shareOfVoicePct    Float?
  sharedKeywordsCount Int?
  gapsCount          Int?

  capturedAt         DateTime   @default(now())

  @@index([clientId, capturedAt])
  @@index([competitorId, capturedAt])
}

model CompetitorKeywordGap {
  id                 String     @id @default(cuid())
  clientId           String
  client             Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  competitorId       String
  competitor         Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  keyword            String
  competitorPosition Int
  searchVolume       Int?
  keywordDifficulty  Int?
  intent             String?

  capturedAt         DateTime   @default(now())

  @@index([clientId, capturedAt])
  @@index([competitorId, capturedAt])
  @@index([clientId, searchVolume])
}

model Audit {
  id               String   @id @default(cuid())
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id])
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id])
  type             String   @default("complete") // "quick" | "complete"
  status           String   @default("completed") // "pending" | "running" | "completed" | "failed"
  date             DateTime @default(now())
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  scoreOverall     Int      @default(0)
  scoreTechnical   Int      @default(0)
  scorePerformance Int      @default(0)
  scoreContent     Int      @default(0)
  accessibilityScore Int?
  seoScore         Int?
  issues           Json     @default("[]")
  pagesCrawled     Int      @default(0)
  pagesIndexable   Int      @default(0)
  brokenPages      Int      @default(0)
  redirectPages    Int      @default(0)
  cwvData          Json?
  summary          String?  @db.Text
  error            String?  @db.Text

  auditIssues AuditIssue[]

  @@index([clientId, date])
  @@index([siteId, date])
}

model AuditIssue {
  id          String   @id @default(cuid())
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category    String   // "technical" | "performance" | "content" | "seo" | "accessibility"
  severity    String   // "critical" | "high" | "medium" | "low" | "info"
  type        String   // e.g. "missing_meta_description", "broken_link", "slow_lcp"
  title       String
  description String   @db.Text
  affectedUrl String?
  count       Int      @default(1)
  data        Json?

  @@index([auditId, severity])
}

model Backlink {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  siteId          String?
  site            Site?          @relation(fields: [siteId], references: [id])
  sourceDomain    String
  sourceUrl       String
  targetUrl       String
  anchorText      String?
  followType      String         // "follow" | "nofollow" | "ugc" | "sponsored"
  domainAuthority Int?           // DA del dominio fuente (0-100)
  firstSeen       DateTime
  lastSeen        DateTime
  lostAt          DateTime?      // fecha en que se marcó LOST
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  status          BacklinkStatus @default(ACTIVE)

  @@unique([clientId, sourceUrl, targetUrl])
  @@index([clientId, status])
  @@index([clientId, sourceDomain])
  @@index([clientId, firstSeen])
}

model BacklinkSnapshot {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  totalBacklinks Int
  uniqueDomains  Int
  avgDomainRank  Float?
  dofollowCount  Int
  nofollowCount  Int
  gainedThisWeek Int      @default(0)
  lostThisWeek   Int      @default(0)
  capturedAt     DateTime @default(now())

  @@index([clientId, capturedAt])
}

model PageMetric {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  url         String
  date        DateTime
  source      String
  clicks      Int?
  impressions Int?
  ctr         Float?
  position    Float?
  sessions    Int?
  bounceRate  Float?
  conversions Int?

  @@index([siteId, url, date])
}

model Insight {
  id               String      @id @default(cuid())
  clientId         String
  client           Client      @relation(fields: [clientId], references: [id])
  type             InsightType
  severity         String
  title            String
  description      String      @db.Text
  suggestedAction  String?     @db.Text
  dataPoints       Json?
  affectedUrls     String[]
  affectedKeywords String[]
  generatedAt      DateTime    @default(now())
  acknowledgedAt   DateTime?
  dismissed        Boolean     @default(false)
}

model TimelineEvent {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  date        DateTime
  type        EventType
  title       String
  description String?   @db.Text
  source      String
}

model AiSearchVisibility {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  date      DateTime
  llmSource String
  query     String
  mentioned Boolean
  position  Int?
  context   String?  @db.Text
}

model ClientUser {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  email       String
  name        String?
  lastLoginAt DateTime?
}

model ApiUsage {
  id       String   @id @default(cuid())
  provider String
  endpoint String
  cost     Decimal  @db.Decimal(10, 6)
  clientId String?
  date     DateTime @default(now())

  @@index([provider, date])
  @@index([clientId, date])
}

model JobLog {
  id        String   @id @default(cuid())
  jobName   String
  clientId  String?
  status    String
  error     String?  @db.Text
  attempts  Int
  createdAt DateTime @default(now())

  @@index([jobName, createdAt])
}

enum SeoPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum CycleStatus {
  PLANNING
  ACTIVE
  CLOSING
  CLOSED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ValidationStatus {
  PENDING
  VALIDATED
  REFUTED
  PARTIAL
}

enum BacklinkStatus {
  ACTIVE
  LOST
}

enum InsightType {
  OPPORTUNITY
  WARNING
  WIN
  INFO
}

enum EventType {
  ALGORITHM_UPDATE
  CLIENT_LAUNCH
  SEO_ACTION
  EXTERNAL
}
