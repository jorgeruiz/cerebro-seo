# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cerebro_seo"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (magic link para clientes)
EMAIL_SERVER="smtp://user:password@smtp.resend.com:465"
EMAIL_FROM="noreply@clicksociety.mx"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# DataForSEO
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Google APIs
GOOGLE_PAGESPEED_API_KEY=""

# Anthropic
ANTHROPIC_API_KEY=""

# Notion (solo lectura — escrituras van por Cerebro)
NOTION_API_KEY=""

# Cerebro Bridge (sistema hermano)
CEREBRO_API_URL="https://cerebro.clicksociety.mx"
CEREBRO_INTERNAL_SECRET="shared-secret-entre-servicios"

# Storage (PDFs de reportes — Cloudflare R2 o S3)
STORAGE_PROVIDER="r2"
STORAGE_BUCKET="cerebro-seo-reports"
